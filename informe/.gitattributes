# =====================================================================
# .gitattributes -- solo rige dentro de informe/
#
# Por que existe: el README de esta carpeta declara que los fuentes usan
# saltos de linea LF. Sin este archivo, eso dependia de la configuracion
# core.autocrlf de cada maquina del equipo, que no es la misma en todas.
# Aqui queda fijado en el repositorio y deja de depender de quien clone.
# =====================================================================

# Fuentes del informe: LF siempre, en el repositorio y en la copia local.
*.tex text eol=lf
*.md  text eol=lf
*.bib text eol=lf

# El PDF compilado se versiona (es el entregable). Se marca binario de
# forma explicita para que Git no intente normalizarlo ni fusionarlo
# nunca, con independencia de la configuracion local.
*.pdf binary
